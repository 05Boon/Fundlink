<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/tvWelcome" android:textSize="24sp" android:textStyle="bold"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tvOpportunityCount" android:layout_marginTop="16dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tvApplicationCount" android:layout_marginTop="4dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/btnBrowseOpportunities" android:text="Browse opportunities"
        android:layout_marginTop="24dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/btnMyApplications" android:text="My applications"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/btnStudentProfile" android:text="Profile"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/btnStudentLogout" android:text="Log out"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
