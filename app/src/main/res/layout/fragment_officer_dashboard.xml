<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvOfficerWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTotalOpportunities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvPendingApplications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/btnManageOpportunities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Manage opportunities" />

    <Button
        android:id="@+id/btnReviewApplications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Review applications" />

    <Button
        android:id="@+id/btnOfficerLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Log out" />

</LinearLayout>